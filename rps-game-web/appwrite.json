{
  "projectId": "",
  "projectName": "RPS Game Web",
  "functions": [
    {
      "$id": "rps-game-web",
      "name": "rps-game-web",
      "runtime": "node-18.0",
      "entrypoint": "dist/server/server.js",
      "source": ".",
      "ignore": [
        "node_modules",
        ".git",
        ".env",
        "src",
        "public"
      ],
      "buildSettings": {
        "buildCommand": "bun install && bun run build:production",
        "rootDir": "."
      }
    }
  ]
}